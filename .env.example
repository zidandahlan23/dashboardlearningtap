# Set all values in Netlify: Site configuration > Environment variables.
# Scope: Functions (not Build), and do not commit real values to Git.
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
GOOGLE_APPS_SCRIPT_SECRET=PASTE_VALUE_FROM_APPS_SCRIPT_SETUPAPI_LOG
DASHBOARD_ADMIN_PASSWORD=GANTI_DENGAN_PASSWORD_ADMIN_YANG_KUAT

# Optional: leave empty for a public read-only dashboard.
# Set a value to require a dashboard password before records can be shown.
DASHBOARD_VIEW_PASSWORD=
